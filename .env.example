# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. The app verifies PayPal events against the webhook registered for its own URL (scripts/register-paypal-webhook.mjs); set this only to pin a webhook id.
PAYPAL_WEBHOOK_ID=

# Postgres (Neon or any Postgres). Tables create themselves on first use.
DATABASE_URL=

# SignalWire project (dashboard → API). Space URL looks like example.signalwire.com
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Any long random string. SignalWire sends it back on every webhook (?key=), and it signs workspace access tokens.
WEBHOOK_SECRET=

# Filled in by: node --env-file=.env.local scripts/provision-signalwire.mjs https://<your public url> [--phone +1XXXXXXXXXX]
SIGNALWIRE_RESOURCE_ID=
SIGNALWIRE_WEB_ADDRESS_ID=
SIGNALWIRE_WEB_ADDRESS=

# The after-hours phone number routed to the agent (E.164). Also the caller ID when the agent phones the technician.
CALL_CAPTAIN_PHONE=

# Web Push for owner alerts. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.example.com

# Opens the public demo line's workspace: /dashboard?workspace=demo&key=<ADMIN_KEY>
ADMIN_KEY=

# AI for setup (website import, service-area mapping) and the overnight briefing, through the Vercel AI Gateway.
# On Vercel this authenticates automatically; locally set AI_GATEWAY_API_KEY (or run `vercel env pull`).
AI_GATEWAY_API_KEY=
# Optional model override, e.g. anthropic/claude-sonnet-5.5
AI_MODEL=

# Optional: the public URL for link previews (defaults to https://callcaptain.vercel.app)
NEXT_PUBLIC_SITE_URL=
