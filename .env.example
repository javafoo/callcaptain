# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. The app verifies PayPal events against the webhook registered for its own URL (scripts/register-paypal-webhook.mjs); set this only to pin a webhook id.
PAYPAL_WEBHOOK_ID=

# Postgres (Neon or any Postgres). The jobs table creates itself on first use.
DATABASE_URL=

# SignalWire project (dashboard → API). Space URL looks like example.signalwire.com
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# Any long random string. SignalWire sends it back on every webhook (?key=).
WEBHOOK_SECRET=

# Filled in by: node --env-file=.env.local scripts/provision-signalwire.mjs https://<your public url>
SIGNALWIRE_RESOURCE_ID=
SIGNALWIRE_WEB_ADDRESS_ID=
SIGNALWIRE_WEB_ADDRESS=
